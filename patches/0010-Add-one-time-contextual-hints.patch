diff --git a/lanternfall/src/core/Hints.ts b/lanternfall/src/core/Hints.ts
new file mode 100644
index 0000000..769d39d
--- /dev/null
+++ b/lanternfall/src/core/Hints.ts
@@ -0,0 +1,106 @@
+import { KeyValueStore, readJson } from './storage';
+
+/** What the hint system needs to know about the player right now. */
+export interface HintContext {
+  /** Id of the platform or mover the player is standing on, or null in mid-air. */
+  platformId: string | null;
+  /** How many lantern pulses the player has fired this run. */
+  pulsesFired: number;
+  /** Falls since the last checkpoint was reached. */
+  fallsSinceCheckpoint: number;
+  /** Seconds the player has stood on the current platform. */
+  secondsOnPlatform: number;
+}
+
+export interface HintDef {
+  id: string;
+  text: string;
+  /** True when the hint would help right now. A hint is only ever shown once. */
+  when: (c: HintContext) => boolean;
+}
+
+/** Short tips that teach the rules the first time they matter. Order = priority when several match. */
+export const HINTS: readonly HintDef[] = [
+  {
+    id: 'stuck',
+    text: 'Stuck? Press Q before a leap: the pulse reveals stones your lantern cannot reach.',
+    when: (c) => c.fallsSinceCheckpoint >= 3,
+  },
+  {
+    id: 'camera',
+    text: 'Drag the mouse (or use the arrow keys) to turn the camera.',
+    when: (c) => c.platformId === 'S' && c.secondsOnPlatform >= 12,
+  },
+  {
+    id: 'pulse',
+    text: 'Gap too wide to see across? Press Q to pulse and reveal the stones beyond.',
+    when: (c) => (c.platformId === 'H2' || c.platformId === 'C1') && c.secondsOnPlatform >= 1.5 && c.pulsesFired === 0,
+  },
+  {
+    id: 'beacon',
+    text: 'A dormant crystal waits on the side ledge. Pulse close to it to wake it.',
+    when: (c) => c.platformId === 'R2a' && c.secondsOnPlatform >= 1.5,
+  },
+  {
+    id: 'drift',
+    text: 'These stones drift back and forth. Wait for one to reach you, then jump. The dark one needs your light.',
+    when: (c) => c.platformId === 'G2' && c.secondsOnPlatform >= 1.5,
+  },
+  {
+    id: 'lift',
+    text: 'The lift only reaches the gate at the top of its ride. Time your jump.',
+    when: (c) => c.platformId === 'R3a' && c.secondsOnPlatform >= 1.5,
+  },
+];
+
+export interface HintOptions {
+  /** Minimum seconds between two hints, so tips never stack up. */
+  cooldown?: number;
+  key?: string;
+}
+
+/**
+ * Decides when to show a tip. Each tip is shown once ever (remembered between sessions),
+ * and never sooner than `cooldown` seconds after the previous one.
+ */
+export class HintEngine {
+  private readonly seen: Set<string>;
+  private readonly cooldown: number;
+  private readonly key: string;
+  private sinceLast: number;
+
+  constructor(
+    private readonly store: KeyValueStore,
+    private readonly hints: readonly HintDef[] = HINTS,
+    options: HintOptions = {},
+  ) {
+    this.cooldown = options.cooldown ?? 8;
+    this.key = options.key ?? 'lanternfall.hints';
+    this.seen = new Set(HintEngine.sanitize(readJson(store, this.key)));
+    this.sinceLast = this.cooldown; // the first hint may show immediately
+  }
+
+  /** Keep only string ids from whatever was stored. */
+  static sanitize(raw: unknown): string[] {
+    if (!Array.isArray(raw)) return [];
+    return raw.filter((v): v is string => typeof v === 'string');
+  }
+
+  hasSeen(id: string): boolean {
+    return this.seen.has(id);
+  }
+
+  /** Advance the clock by `dt` seconds. Returns a hint to show now, or null. */
+  update(dt: number, ctx: HintContext): HintDef | null {
+    this.sinceLast += dt;
+    if (this.sinceLast < this.cooldown) return null;
+    for (const h of this.hints) {
+      if (this.seen.has(h.id) || !h.when(ctx)) continue;
+      this.seen.add(h.id);
+      this.sinceLast = 0;
+      this.store.setItem(this.key, JSON.stringify([...this.seen]));
+      return h;
+    }
+    return null;
+  }
+}
diff --git a/lanternfall/tests/Hints.test.ts b/lanternfall/tests/Hints.test.ts
new file mode 100644
index 0000000..1b25838
--- /dev/null
+++ b/lanternfall/tests/Hints.test.ts
@@ -0,0 +1,92 @@
+import { describe, expect, it } from 'vitest';
+import { HINTS, HintContext, HintDef, HintEngine } from '../src/core/Hints';
+import { MemoryStore } from '../src/core/storage';
+
+const base: HintContext = { platformId: null, pulsesFired: 0, fallsSinceCheckpoint: 0, secondsOnPlatform: 0 };
+const ctx = (patch: Partial<HintContext>): HintContext => ({ ...base, ...patch });
+
+describe('HINTS data', () => {
+  it('has unique ids and non-empty text', () => {
+    const ids = HINTS.map((h) => h.id);
+    expect(new Set(ids).size).toBe(ids.length);
+    for (const h of HINTS) expect(h.text.length).toBeGreaterThan(10);
+  });
+
+  it('shows nothing while the player is simply in mid-air at the start', () => {
+    for (const h of HINTS) expect(h.when(base)).toBe(false);
+  });
+
+  it('the pulse tip stops once the player has pulsed', () => {
+    const pulse = HINTS.find((h) => h.id === 'pulse') as HintDef;
+    expect(pulse.when(ctx({ platformId: 'H2', secondsOnPlatform: 2, pulsesFired: 0 }))).toBe(true);
+    expect(pulse.when(ctx({ platformId: 'H2', secondsOnPlatform: 2, pulsesFired: 1 }))).toBe(false);
+  });
+
+  it('every platform-based tip waits a moment before appearing', () => {
+    for (const id of ['H2', 'C1', 'R2a', 'G2', 'R3a']) {
+      const early = HINTS.filter((h) => h.when(ctx({ platformId: id, secondsOnPlatform: 0.1 })));
+      expect(early).toEqual([]);
+    }
+  });
+});
+
+describe('HintEngine', () => {
+  const tips: HintDef[] = [
+    { id: 'a', text: 'tip a is here', when: (c) => c.platformId === 'A' },
+    { id: 'b', text: 'tip b is here', when: (c) => c.platformId === 'B' },
+  ];
+
+  it('returns the first matching hint, once', () => {
+    const e = new HintEngine(new MemoryStore(), tips, { cooldown: 0 });
+    expect(e.update(0.1, ctx({ platformId: 'A' }))?.id).toBe('a');
+    expect(e.update(0.1, ctx({ platformId: 'A' }))).toBeNull();
+    expect(e.hasSeen('a')).toBe(true);
+  });
+
+  it('waits for the cooldown between hints', () => {
+    const e = new HintEngine(new MemoryStore(), tips, { cooldown: 5 });
+    expect(e.update(0.1, ctx({ platformId: 'A' }))?.id).toBe('a');
+    expect(e.update(2, ctx({ platformId: 'B' }))).toBeNull();
+    expect(e.update(3.5, ctx({ platformId: 'B' }))?.id).toBe('b');
+  });
+
+  it('stays quiet when nothing matches', () => {
+    const e = new HintEngine(new MemoryStore(), tips, { cooldown: 0 });
+    expect(e.update(1, ctx({ platformId: 'Z' }))).toBeNull();
+    expect(e.hasSeen('a')).toBe(false);
+  });
+
+  it('remembers seen hints between sessions', () => {
+    const store = new MemoryStore();
+    new HintEngine(store, tips, { cooldown: 0 }).update(1, ctx({ platformId: 'A' }));
+    const again = new HintEngine(store, tips, { cooldown: 0 });
+    expect(again.hasSeen('a')).toBe(true);
+    expect(again.update(1, ctx({ platformId: 'A' }))).toBeNull();
+  });
+
+  it('ignores corrupt or wrongly typed saved data', () => {
+    const store = new MemoryStore();
+    store.setItem('lanternfall.hints', '{oops');
+    expect(new HintEngine(store, tips).hasSeen('a')).toBe(false);
+    store.setItem('lanternfall.hints', JSON.stringify(['a', 7, null, { x: 1 }]));
+    const e = new HintEngine(store, tips);
+    expect(e.hasSeen('a')).toBe(true);
+    expect(HintEngine.sanitize('nope')).toEqual([]);
+  });
+
+  it('earlier hints in the list win when several match at once', () => {
+    const both: HintDef[] = [
+      { id: 'first', text: 'first tip text', when: () => true },
+      { id: 'second', text: 'second tip text', when: () => true },
+    ];
+    const e = new HintEngine(new MemoryStore(), both, { cooldown: 0 });
+    expect(e.update(1, base)?.id).toBe('first');
+    expect(e.update(1, base)?.id).toBe('second');
+  });
+
+  it('shows the stuck tip after three falls even with the real hint list', () => {
+    const e = new HintEngine(new MemoryStore());
+    expect(e.update(1, ctx({ fallsSinceCheckpoint: 2 }))).toBeNull();
+    expect(e.update(1, ctx({ fallsSinceCheckpoint: 3 }))?.id).toBe('stuck');
+  });
+});
