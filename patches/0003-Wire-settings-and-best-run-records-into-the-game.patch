-    this.pitch = THREE.MathUtils.clamp(this.pitch + e.movementY * 0.004, 0.12, 1.2);
+    this.look(e.movementX, e.movementY);
   };
   private onWheel = (e: WheelEvent): void => {
     e.preventDefault();
