diff --git a/lanternfall/tests/Room3.test.ts b/lanternfall/tests/Room3.test.ts
new file mode 100644
index 0000000..68b189c
--- /dev/null
+++ b/lanternfall/tests/Room3.test.ts
@@ -0,0 +1,86 @@
+import { describe, expect, it } from 'vitest';
+import { PHYSICS } from '../src/physics/PlayerBody';
+import { MOVERS, PLATFORMS, ROUTE_3, platformBox } from '../src/world/LevelData';
+import { cycleLength, moverBox, moverTop } from '../src/world/MovingPlatform';
+import { overlaps } from '../src/physics/aabb';
+import { spotOf, windowFraction } from './helpers/room3Sim';
+
+const hops: Array<[string, string]> = ROUTE_3.slice(0, -1).map((id, i) => [id, ROUTE_3[i + 1]]);
+
+describe('Room 3 layout', () => {
+  it('every route entry is a real platform or mover, with no id used twice', () => {
+    const ids = [...PLATFORMS.map((p) => p.id), ...MOVERS.map((m) => m.id)];
+    expect(new Set(ids).size).toBe(ids.length);
+    for (const id of ROUTE_3) expect(ids.includes(id)).toBe(true);
+    expect(ROUTE_3[0]).toBe('G2');
+    expect(ROUTE_3[ROUTE_3.length - 1]).toBe('G3');
+  });
+
+  it('movers never pass through a static platform at any moment of their cycle', () => {
+    const statics = PLATFORMS.map(platformBox);
+    for (const m of MOVERS) {
+      for (let t = 0; t < 20; t += 0.25) {
+        for (const s of statics) expect(overlaps(moverBox(m, t), s)).toBe(false);
+      }
+    }
+  });
+
+  it('movers stay on their line: sideways movers keep their height, the lift keeps its x and z', () => {
+    for (const m of MOVERS) {
+      for (let t = 0; t < 12; t += 0.5) {
+        const c = moverTop(m, t);
+        if (m.from.topY === m.to.topY) expect(c.topY).toBe(m.from.topY);
+        if (m.from.x === m.to.x && m.from.z === m.to.z) {
+          expect(c.x).toBe(m.from.x);
+          expect(c.z).toBe(m.from.z);
+        }
+      }
+    }
+  });
+
+  /** Height of a route entry for a given hop: the lift is entered at the bottom of its ride and left from the top. */
+  const V1 = MOVERS.find((m) => m.id === 'V1')!;
+  const heightFor = (id: string, role: 'source' | 'target'): number => {
+    if (id === 'V1') return role === 'target' ? V1.from.topY : V1.to.topY;
+    return spotOf(id, 0).topY;
+  };
+
+  it('every step up along the route is within what a jump can clear', () => {
+    const maxRise = PHYSICS.jumpSpeed ** 2 / (2 * PHYSICS.gravity);
+    for (const [a, b] of hops) {
+      const rise = heightFor(b, 'target') - heightFor(a, 'source');
+      expect(rise).toBeLessThan(maxRise - 0.5);
+    }
+  });
+
+  it('the lift is mandatory: the gate is too high to jump to from the rest stop or the bottom of the lift', () => {
+    const maxRise = PHYSICS.jumpSpeed ** 2 / (2 * PHYSICS.gravity);
+    const g3 = spotOf('G3', 0).topY;
+    expect(g3 - spotOf('R3a', 0).topY).toBeGreaterThan(maxRise);
+    expect(g3 - V1.from.topY).toBeGreaterThan(maxRise);
+  });
+
+  it('the lift is long enough to be worth waiting for but short enough to wait out', () => {
+    expect(V1.to.topY - V1.from.topY).toBeGreaterThan(2);
+    expect(cycleLength(V1)).toBeLessThan(10);
+  });
+});
+
+describe('Room 3 is fair: every hop has a generous timing window', () => {
+  // A bot that always runs and jumps immediately, started at every moment of the cycle.
+  // It must succeed from a good share of them, so a human who waits and watches has plenty of room.
+  for (const [a, b] of hops) {
+    it(`${a} -> ${b}: at least 25% of start moments work`, () => {
+      expect(windowFraction(a, b)).toBeGreaterThanOrEqual(0.25);
+    });
+  }
+
+  it('there is not a single hop that is always trivial for all three movers (timing still matters somewhere)', () => {
+    const fractions = hops.map(([a, b]) => windowFraction(a, b));
+    expect(fractions.some((f) => f < 0.95)).toBe(true);
+  });
+
+  it('M1 and M2 are out of step, so crossing from one to the other needs a look first', () => {
+    expect(windowFraction('M1', 'M2')).toBeLessThan(0.95);
+  });
+});
diff --git a/lanternfall/tests/helpers/room3Sim.ts b/lanternfall/tests/helpers/room3Sim.ts
new file mode 100644
index 0000000..3f6d2dc
--- /dev/null
+++ b/lanternfall/tests/helpers/room3Sim.ts
@@ -0,0 +1,88 @@
+import { PLAYER_HALF, PlayerBody } from '../../src/physics/PlayerBody';
+import { Lantern, RevealTracker } from '../../src/world/LightReveal';
+import { MOVERS, MoverDef, PLATFORMS, platformBox } from '../../src/world/LevelData';
+import { applyMovers, cycleLength, moverBox, moverTop } from '../../src/world/MovingPlatform';
+
+/** Same fixed step the game uses. */
+export const STEP = 1 / 60;
+
+const staticBoxes = PLATFORMS.filter((p) => !p.hidden).map(platformBox);
+const clamp = (v: number, lo: number, hi: number): number => Math.min(hi, Math.max(lo, v));
+
+interface Spot {
+  x: number;
+  topY: number;
+  z: number;
+  w: number;
+  d: number;
+  mover: MoverDef | null;
+}
+
+export function spotOf(id: string, t: number, movers: readonly MoverDef[] = MOVERS): Spot {
+  const m = movers.find((q) => q.id === id);
+  if (m) return { ...moverTop(m, t), w: m.w, d: m.d, mover: m };
+  const p = PLATFORMS.find((q) => q.id === id);
+  if (!p) throw new Error(`Unknown platform ${id}`);
+  return { x: p.cx, topY: p.topY, z: p.cz, w: p.w, d: p.d, mover: null };
+}
+
+/**
+ * A bot that stands on `fromId` at time t0, runs toward -Z, jumps at the edge and steers at `toId`.
+ * It pulses the lantern first when the target is a hidden (dark) mover.
+ * Returns true if it lands on the target.
+ */
+export function runHop(fromId: string, toId: string, t0: number, movers: readonly MoverDef[] = MOVERS): boolean {
+  const from = spotOf(fromId, t0, movers);
+  const target0 = spotOf(toId, t0, movers);
+  const run = from.d >= 4 ? 2 : 1;
+  const x0 = from.mover ? from.x : clamp(target0.x, from.x - (from.w / 2 - 0.5), from.x + (from.w / 2 - 0.5));
+  const body = new PlayerBody({ x: x0, y: from.topY + PLAYER_HALF.y + 0.01, z: from.z - from.d / 2 + run });
+
+  const reveal = new RevealTracker();
+  const lantern = new Lantern();
+  const hiddenNow = (t: number) => movers.filter((m) => m.hidden).map((m) => ({ id: m.id, box: moverBox(m, t) }));
+  const isDark = (id: string) => movers.some((m) => m.id === id && m.hidden);
+  let t = t0;
+
+  const tick = (jump: boolean, mx: number, mz: number): void => {
+    const prev = t;
+    t += STEP;
+    lantern.update(STEP);
+    reveal.update(STEP, hiddenNow(t), { x: body.pos.x, y: body.feetY + 1.3, z: body.pos.z }, lantern.radius);
+    const boxes = applyMovers(body, movers, prev, t, (id) => !isDark(id) || reveal.isSolid(id));
+    body.step(STEP, { moveX: mx, moveZ: mz, jumpPressed: jump }, [...staticBoxes, ...boxes]);
+  };
+
+  for (let i = 0; i < 10; i++) tick(false, 0, 0); // settle (a dark source lights up under our feet)
+  if (isDark(toId)) lantern.tryPulse();
+
+  let jumped = false;
+  for (let i = 0; i < 4 / STEP; i++) {
+    const target = spotOf(toId, t, movers);
+    const here = spotOf(fromId, t, movers);
+    const atEdge = body.pos.z - (here.z - here.d / 2) <= 0.1;
+    const wantJump = !jumped && body.grounded && atEdge;
+    if (wantJump) jumped = true;
+    tick(wantJump, clamp((target.x - body.pos.x) * 2, -1, 1), -1);
+    if (jumped && body.grounded) {
+      const end = spotOf(toId, t, movers);
+      return Math.abs(body.pos.x - end.x) <= end.w / 2 && Math.abs(body.pos.z - end.z) <= end.d / 2 && Math.abs(body.feetY - end.topY) < 0.06;
+    }
+    if (body.pos.y < Math.min(from.topY, target.topY) - 5) return false;
+  }
+  return false;
+}
+
+/** Fraction of start moments (spread over one full cycle) from which the hop succeeds. */
+export function windowFraction(fromId: string, toId: string, movers: readonly MoverDef[] = MOVERS, stepSeconds = 0.2): number {
+  const involved = movers.filter((m) => m.id === fromId || m.id === toId);
+  const cycle = Math.max(...involved.map(cycleLength), 1);
+  let ok = 0;
+  let n = 0;
