@@ -94,6 +104,10 @@ export class Hud {
     this.q<HTMLInputElement>('#set-volume').value = String(s.volume);
     this.q<HTMLInputElement>('#set-sens').value = String(s.sensitivity);
     this.q<HTMLInputElement>('#set-invert').checked = s.invertY;
