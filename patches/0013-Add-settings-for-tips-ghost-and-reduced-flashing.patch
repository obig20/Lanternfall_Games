From cc7f8e5955f1a0a67e4acfc895a699ec42be9739 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 31 Oct 2026 11:00:13 +0000
Subject: [PATCH 13/18] Add settings for tips, ghost and reduced flashing

Old saves load with defaults. With tips off the hint engine is not
consulted, so tips are not marked as seen while hidden.
---
 lanternfall/src/core/Game.ts       |  7 ++++--
 lanternfall/src/core/Settings.ts   | 24 +++++++++++++++++--
 lanternfall/src/ui/Hud.ts          | 19 +++++++++++++--
 lanternfall/tests/Settings.test.ts | 38 +++++++++++++++++++++++++++++-
 4 files changed, 81 insertions(+), 7 deletions(-)

diff --git a/lanternfall/src/core/Game.ts b/lanternfall/src/core/Game.ts
index 60b495f..195203f 100644
--- a/lanternfall/src/core/Game.ts
+++ b/lanternfall/src/core/Game.ts
@@ -20,7 +20,7 @@ import { FallLog } from './FallLog';
 import { HintEngine } from './Hints';
 import { ProgressStore } from './Progress';
 import { Records, formatTime } from './Records';
-import { SettingsStore } from './Settings';
+import { Settings, SettingsStore } from './Settings';
 import { SplitBook, formatDelta } from './Splits';
 import { browserStore } from './storage';
 import { GameState } from './GameState';
@@ -123,10 +123,11 @@ export class Game {
     void this.loadCharacter();
   }
 
-  private applySettings(v: Readonly<{ volume: number; sensitivity: number; invertY: boolean }>): void {
+  private applySettings(v: Readonly<Settings>): void {
     this.audio.setVolume(v.volume);
     this.rig.sensitivity = v.sensitivity;
     this.rig.invertY = v.invertY;
+    this.hud.reduceFlash = v.reduceFlash;
   }
 
   /** Load the FBX character in the background; the built-in character is used until (or unless) it loads. */
@@ -401,6 +402,8 @@ export class Game {
   }
 
   private showHint(dt: number): void {
+    // Tips switched off: do not even ask, or the engine would mark them as seen and they would be lost.
+    if (!this.settings.get().showHints) return;
     const hint = this.hints.update(dt, {
       platformId: this.standingOn,
       pulsesFired: this.pulsesFired,
diff --git a/lanternfall/src/core/Settings.ts b/lanternfall/src/core/Settings.ts
index 5626789..84596e1 100644
--- a/lanternfall/src/core/Settings.ts
+++ b/lanternfall/src/core/Settings.ts
@@ -6,9 +6,22 @@ export interface Settings {
   /** Camera turn speed multiplier. */
   sensitivity: number;
   invertY: boolean;
+  /** Show one-time tips (see Hints.ts). */
+  showHints: boolean;
+  /** Show the translucent ghost of your best run. */
+  showGhost: boolean;
+  /** Skip the dark flash when you fall and respawn. */
+  reduceFlash: boolean;
 }
 
-export const DEFAULT_SETTINGS: Readonly<Settings> = { volume: 0.5, sensitivity: 1, invertY: false };
+export const DEFAULT_SETTINGS: Readonly<Settings> = {
+  volume: 0.5,
+  sensitivity: 1,
+  invertY: false,
+  showHints: true,
+  showGhost: true,
+  reduceFlash: false,
+};
 export const SETTING_LIMITS = {
   volume: { min: 0, max: 1 },
   sensitivity: { min: 0.3, max: 2.5 },
@@ -16,6 +29,10 @@ export const SETTING_LIMITS = {
 
 const clamp = (v: number, lo: number, hi: number): number => Math.min(hi, Math.max(lo, v));
 
+function bool(raw: unknown, fallback: boolean): boolean {
+  return typeof raw === 'boolean' ? raw : fallback;
+}
+
 function num(raw: unknown, fallback: number, lo: number, hi: number): number {
   return typeof raw === 'number' && Number.isFinite(raw) ? clamp(raw, lo, hi) : fallback;
 }
@@ -26,7 +43,10 @@ export function sanitizeSettings(raw: unknown): Settings {
   return {
     volume: num(r.volume, DEFAULT_SETTINGS.volume, SETTING_LIMITS.volume.min, SETTING_LIMITS.volume.max),
     sensitivity: num(r.sensitivity, DEFAULT_SETTINGS.sensitivity, SETTING_LIMITS.sensitivity.min, SETTING_LIMITS.sensitivity.max),
-    invertY: typeof r.invertY === 'boolean' ? r.invertY : DEFAULT_SETTINGS.invertY,
+    invertY: bool(r.invertY, DEFAULT_SETTINGS.invertY),
+    showHints: bool(r.showHints, DEFAULT_SETTINGS.showHints),
+    showGhost: bool(r.showGhost, DEFAULT_SETTINGS.showGhost),
+    reduceFlash: bool(r.reduceFlash, DEFAULT_SETTINGS.reduceFlash),
   };
 }
 
diff --git a/lanternfall/src/ui/Hud.ts b/lanternfall/src/ui/Hud.ts
