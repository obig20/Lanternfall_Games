diff --git a/lanternfall/src/core/Records.ts b/lanternfall/src/core/Records.ts
new file mode 100644
index 0000000..87c3bc7
--- /dev/null
+++ b/lanternfall/src/core/Records.ts
@@ -0,0 +1,88 @@
+import { KeyValueStore, readJson } from './storage';
+
+export interface RunResult {
+  /** Seconds. */
+  time: number;
+  falls: number;
+}
+
+export interface RunRecord {
+  bestTime: number | null;
+  fewestFalls: number | null;
+  /** Number of completed runs. */
+  runs: number;
+}
+
+export interface SubmitOutcome {
+  newBestTime: boolean;
+  newBestFalls: boolean;
+  /** True only when there was an earlier record to beat (the first run is not a "new best"). */
+  beatPrevious: boolean;
+  record: RunRecord;
+}
+
+const EMPTY: RunRecord = { bestTime: null, fewestFalls: null, runs: 0 };
+
+const validNumber = (v: unknown, integer: boolean): v is number =>
+  typeof v === 'number' && Number.isFinite(v) && v >= 0 && (!integer || Number.isInteger(v));
+
+function sanitizeRecord(raw: unknown): RunRecord {
+  if (typeof raw !== 'object' || raw === null) return { ...EMPTY };
+  const r = raw as Record<string, unknown>;
+  return {
+    bestTime: validNumber(r.bestTime, false) ? r.bestTime : null,
+    fewestFalls: validNumber(r.fewestFalls, true) ? r.fewestFalls : null,
+    runs: validNumber(r.runs, true) ? r.runs : 0,
+  };
+}
+
+/** "1:05.3" style time. */
+export function formatTime(seconds: number): string {
+  const safe = Math.max(0, seconds);
+  const tenths = Math.floor(safe * 10);
+  const m = Math.floor(tenths / 600);
+  const s = Math.floor((tenths % 600) / 10);
+  return `${m}:${s.toString().padStart(2, '0')}.${tenths % 10}`;
+}
+
+/** Best time and fewest falls per run id, saved between sessions. */
+export class Records {
+  constructor(
+    private readonly store: KeyValueStore,
+    private readonly key = 'lanternfall.records',
+  ) {}
+
+  private all(): Record<string, RunRecord> {
+    const raw = readJson(this.store, this.key);
+    if (typeof raw !== 'object' || raw === null) return {};
+    const out: Record<string, RunRecord> = {};
+    for (const [id, value] of Object.entries(raw)) out[id] = sanitizeRecord(value);
+    return out;
+  }
+
+  get(runId: string): RunRecord {
+    return this.all()[runId] ?? { ...EMPTY };
+  }
+
+  /** Record a finished run and say whether it beat the old best. */
+  submit(runId: string, run: RunResult): SubmitOutcome {
+    const all = this.all();
+    const before = all[runId] ?? { ...EMPTY };
+    const had = before.runs > 0;
+    const newBestTime = before.bestTime === null || run.time < before.bestTime;
+    const newBestFalls = before.fewestFalls === null || run.falls < before.fewestFalls;
+    const record: RunRecord = {
+      bestTime: newBestTime ? run.time : before.bestTime,
+      fewestFalls: newBestFalls ? run.falls : before.fewestFalls,
+      runs: before.runs + 1,
+    };
+    all[runId] = record;
+    this.store.setItem(this.key, JSON.stringify(all));
+    return {
+      newBestTime: had && newBestTime,
+      newBestFalls: had && newBestFalls,
+      beatPrevious: had && (newBestTime || newBestFalls),
+      record,
+    };
+  }
+}
diff --git a/lanternfall/src/core/Settings.ts b/lanternfall/src/core/Settings.ts
new file mode 100644
index 0000000..5626789
--- /dev/null
+++ b/lanternfall/src/core/Settings.ts
@@ -0,0 +1,67 @@
+import { KeyValueStore, readJson } from './storage';
+
+export interface Settings {
+  /** Master volume, 0..1. */
+  volume: number;
+  /** Camera turn speed multiplier. */
+  sensitivity: number;
+  invertY: boolean;
+}
+
+export const DEFAULT_SETTINGS: Readonly<Settings> = { volume: 0.5, sensitivity: 1, invertY: false };
+export const SETTING_LIMITS = {
+  volume: { min: 0, max: 1 },
+  sensitivity: { min: 0.3, max: 2.5 },
+} as const;
+
+const clamp = (v: number, lo: number, hi: number): number => Math.min(hi, Math.max(lo, v));
+
+function num(raw: unknown, fallback: number, lo: number, hi: number): number {
+  return typeof raw === 'number' && Number.isFinite(raw) ? clamp(raw, lo, hi) : fallback;
+}
+
+/** Turn anything (old saves, hand-edited JSON, garbage) into a valid Settings object. */
+export function sanitizeSettings(raw: unknown): Settings {
+  const r = (typeof raw === 'object' && raw !== null ? raw : {}) as Record<string, unknown>;
+  return {
+    volume: num(r.volume, DEFAULT_SETTINGS.volume, SETTING_LIMITS.volume.min, SETTING_LIMITS.volume.max),
+    sensitivity: num(r.sensitivity, DEFAULT_SETTINGS.sensitivity, SETTING_LIMITS.sensitivity.min, SETTING_LIMITS.sensitivity.max),
+    invertY: typeof r.invertY === 'boolean' ? r.invertY : DEFAULT_SETTINGS.invertY,
+  };
+}
+
+type Listener = (s: Settings) => void;
+
+/** Loads, validates, saves and announces changes to the player's settings. */
+export class SettingsStore {
+  private current: Settings;
+  private readonly listeners = new Set<Listener>();
+
+  constructor(
+    private readonly store: KeyValueStore,
+    private readonly key = 'lanternfall.settings',
+  ) {
+    this.current = sanitizeSettings(readJson(store, key));
+  }
+
+  get(): Readonly<Settings> {
+    return this.current;
+  }
+
+  set(patch: Partial<Settings>): Settings {
+    this.current = sanitizeSettings({ ...this.current, ...patch });
+    this.store.setItem(this.key, JSON.stringify(this.current));
+    for (const fn of this.listeners) fn(this.current);
+    return this.current;
+  }
+
+  reset(): Settings {
+    return this.set({ ...DEFAULT_SETTINGS });
+  }
+
+  /** Returns an unsubscribe function. */
+  onChange(fn: Listener): () => void {
+    this.listeners.add(fn);
+    return () => this.listeners.delete(fn);
+  }
+}
diff --git a/lanternfall/src/core/storage.ts b/lanternfall/src/core/storage.ts
new file mode 100644
index 0000000..f727bc4
--- /dev/null
+++ b/lanternfall/src/core/storage.ts
@@ -0,0 +1,49 @@
+/** The tiny part of localStorage we use, so tests can swap in an in-memory version. */
+export interface KeyValueStore {
+  getItem(key: string): string | null;
+  setItem(key: string, value: string): void;
+}
+
+/** In-memory store: used by tests, and as the fallback when localStorage is blocked. */
+export class MemoryStore implements KeyValueStore {
+  private data = new Map<string, string>();
+  getItem(key: string): string | null {
+    return this.data.get(key) ?? null;
+  }
+  setItem(key: string, value: string): void {
+    this.data.set(key, value);
+  }
+}
+
+/**
+ * localStorage can throw (private browsing, blocked cookies, storage full).
+ * Wrap it so the game keeps working and simply forgets between sessions.
+ */
+export function browserStore(): KeyValueStore {
+  try {
+    const ls = window.localStorage;
+    ls.setItem('lanternfall.probe', '1');
+    ls.removeItem('lanternfall.probe');
+    return {
+      getItem: (k) => {
+        try { return ls.getItem(k); } catch { return null; }
+      },
+      setItem: (k, v) => {
+        try { ls.setItem(k, v); } catch { /* storage full: ignore */ }
+      },
+    };
+  } catch {
+    return new MemoryStore();
+  }
+}
+
+/** Parse JSON without throwing; returns null for missing or corrupt data. */
+export function readJson(store: KeyValueStore, key: string): unknown {
+  const raw = store.getItem(key);
+  if (raw === null) return null;
+  try {
+    return JSON.parse(raw);
+  } catch {
+    return null;
+  }
+}
diff --git a/lanternfall/tests/Records.test.ts b/lanternfall/tests/Records.test.ts
new file mode 100644
index 0000000..a28ad68
--- /dev/null
+++ b/lanternfall/tests/Records.test.ts
@@ -0,0 +1,71 @@
+import { describe, expect, it } from 'vitest';
+import { Records, formatTime } from '../src/core/Records';
+import { MemoryStore } from '../src/core/storage';
+
+describe('Records', () => {
+  it('has an empty record before any run', () => {
+    expect(new Records(new MemoryStore()).get('tower')).toEqual({ bestTime: null, fewestFalls: null, runs: 0 });
+  });
+
+  it('the first run sets the record but is not "beating" anything', () => {
+    const r = new Records(new MemoryStore());
+    const out = r.submit('tower', { time: 100, falls: 4 });
+    expect(out.beatPrevious).toBe(false);
+    expect(out.newBestTime).toBe(false);
+    expect(out.record).toEqual({ bestTime: 100, fewestFalls: 4, runs: 1 });
+  });
+
+  it('a faster run beats the time but a worse fall count does not replace the best', () => {
+    const r = new Records(new MemoryStore());
+    r.submit('tower', { time: 100, falls: 2 });
+    const out = r.submit('tower', { time: 90, falls: 5 });
+    expect(out.newBestTime).toBe(true);
+    expect(out.newBestFalls).toBe(false);
+    expect(out.record).toEqual({ bestTime: 90, fewestFalls: 2, runs: 2 });
+  });
+
+  it('a slower, clumsier run changes nothing but the run count', () => {
+    const r = new Records(new MemoryStore());
+    r.submit('tower', { time: 60, falls: 0 });
+    const out = r.submit('tower', { time: 80, falls: 3 });
+    expect(out.beatPrevious).toBe(false);
+    expect(out.record).toEqual({ bestTime: 60, fewestFalls: 0, runs: 2 });
+  });
+
+  it('an equal time is not a new best', () => {
+    const r = new Records(new MemoryStore());
+    r.submit('tower', { time: 60, falls: 1 });
+    expect(r.submit('tower', { time: 60, falls: 1 }).beatPrevious).toBe(false);
+  });
+
+  it('keeps separate records per run id and persists them', () => {
+    const mem = new MemoryStore();
+    new Records(mem).submit('a', { time: 10, falls: 0 });
+    new Records(mem).submit('b', { time: 20, falls: 1 });
+    const reloaded = new Records(mem);
+    expect(reloaded.get('a').bestTime).toBe(10);
+    expect(reloaded.get('b').bestTime).toBe(20);
+  });
+
+  it('ignores corrupt or tampered saved data', () => {
+    const mem = new MemoryStore();
+    mem.setItem('lanternfall.records', JSON.stringify({ tower: { bestTime: -5, fewestFalls: 1.5, runs: 'x' }, junk: 7 }));
+    const r = new Records(mem);
+    expect(r.get('tower')).toEqual({ bestTime: null, fewestFalls: null, runs: 0 });
+    expect(r.get('junk')).toEqual({ bestTime: null, fewestFalls: null, runs: 0 });
+    mem.setItem('lanternfall.records', 'not json');
+    expect(r.get('tower').runs).toBe(0);
+  });
+});
+
+describe('formatTime', () => {
+  it('formats minutes, seconds and tenths', () => {
+    expect(formatTime(0)).toBe('0:00.0');
+    expect(formatTime(65.37)).toBe('1:05.3');
+    expect(formatTime(600)).toBe('10:00.0');
+  });
+
+  it('never shows negative time', () => {
+    expect(formatTime(-4)).toBe('0:00.0');
+  });
+});
diff --git a/lanternfall/tests/Settings.test.ts b/lanternfall/tests/Settings.test.ts
new file mode 100644
index 0000000..99191ad
--- /dev/null
+++ b/lanternfall/tests/Settings.test.ts
@@ -0,0 +1,91 @@
+import { describe, expect, it, vi } from 'vitest';
+import { DEFAULT_SETTINGS, SETTING_LIMITS, SettingsStore, sanitizeSettings } from '../src/core/Settings';
+import { KeyValueStore, MemoryStore, readJson } from '../src/core/storage';
+
+describe('sanitizeSettings', () => {
+  it('returns defaults for missing or non-object input', () => {
+    for (const bad of [null, undefined, 42, 'x', [], true]) {
+      expect(sanitizeSettings(bad)).toEqual(DEFAULT_SETTINGS);
+    }
+  });
+
+  it('clamps out-of-range numbers', () => {
+    const s = sanitizeSettings({ volume: 7, sensitivity: -3 });
+    expect(s.volume).toBe(SETTING_LIMITS.volume.max);
+    expect(s.sensitivity).toBe(SETTING_LIMITS.sensitivity.min);
+  });
+
+  it('rejects NaN, Infinity and wrong types field by field', () => {
+    const s = sanitizeSettings({ volume: NaN, sensitivity: '2', invertY: 'yes' });
+    expect(s).toEqual(DEFAULT_SETTINGS);
+    expect(sanitizeSettings({ volume: Infinity }).volume).toBe(DEFAULT_SETTINGS.volume);
+  });
+
+  it('keeps valid fields even when others are bad', () => {
+    expect(sanitizeSettings({ volume: 0.2, invertY: true, sensitivity: 'fast' })).toEqual({
+      volume: 0.2, sensitivity: DEFAULT_SETTINGS.sensitivity, invertY: true,
+    });
+  });
+});
+
+describe('SettingsStore', () => {
+  it('starts with defaults on an empty store', () => {
+    expect(new SettingsStore(new MemoryStore()).get()).toEqual(DEFAULT_SETTINGS);
+  });
+
+  it('saves and reloads', () => {
+    const mem = new MemoryStore();
+    new SettingsStore(mem).set({ volume: 0.9, invertY: true });
+    const again = new SettingsStore(mem).get();
+    expect(again.volume).toBe(0.9);
+    expect(again.invertY).toBe(true);
+  });
+
+  it('survives corrupt saved data', () => {
+    const mem = new MemoryStore();
+    mem.setItem('lanternfall.settings', '{not json');
+    expect(new SettingsStore(mem).get()).toEqual(DEFAULT_SETTINGS);
+  });
+
+  it('merges partial updates and clamps them', () => {
+    const s = new SettingsStore(new MemoryStore());
+    s.set({ sensitivity: 100 });
+    expect(s.get().sensitivity).toBe(SETTING_LIMITS.sensitivity.max);
+    expect(s.get().volume).toBe(DEFAULT_SETTINGS.volume);
+  });
+
+  it('notifies listeners and stops after unsubscribe', () => {
+    const s = new SettingsStore(new MemoryStore());
+    const fn = vi.fn();
+    const off = s.onChange(fn);
+    s.set({ volume: 0.1 });
+    expect(fn).toHaveBeenCalledTimes(1);
+    expect(fn.mock.calls[0][0].volume).toBe(0.1);
+    off();
+    s.set({ volume: 0.2 });
+    expect(fn).toHaveBeenCalledTimes(1);
+  });
+
+  it('reset restores defaults', () => {
+    const s = new SettingsStore(new MemoryStore());
+    s.set({ volume: 0, invertY: true });
+    expect(s.reset()).toEqual(DEFAULT_SETTINGS);
+  });
+});
+
+describe('storage helpers', () => {
+  it('readJson returns null for missing and corrupt values', () => {
+    const mem = new MemoryStore();
+    expect(readJson(mem, 'nope')).toBe(null);
+    mem.setItem('bad', '{{');
+    expect(readJson(mem, 'bad')).toBe(null);
+    mem.setItem('ok', '{"a":1}');
+    expect(readJson(mem, 'ok')).toEqual({ a: 1 });
+  });
+
+  it('a store that throws on write does not crash settings in the caller', () => {
+    const angry: KeyValueStore = { getItem: () => null, setItem: () => { throw new Error('quota'); } };
+    const s = new SettingsStore(angry);
+    expect(() => s.set({ volume: 0.3 })).toThrow(); // browserStore() is what swallows this; the raw store may throw
+  });
+});
