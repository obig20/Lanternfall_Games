       .settings .check { justify-content: flex-start; gap: 8px; }
+      .keys { display: flex; flex-direction: column; gap: 6px; margin: 10px 0 4px; text-align: left; font-size: 14px; max-height: 34vh; overflow-y: auto; padding-right: 6px; }
+      .keyrow { display: flex; align-items: center; justify-content: space-between; gap: 16px; }
+      .keyrow button { margin: 0; padding: 4px 14px; min-width: 96px; font-size: 13px; letter-spacing: 0; pointer-events: auto; }
